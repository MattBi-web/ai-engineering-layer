{
  "_comment": "Line 2 — Claude Code hooks. MERGE this into the target repo's .claude/settings.json (PROJECT, not ~/.claude). Do NOT overwrite existing settings: add only the 'hooks' key. ${CLAUDE_PROJECT_DIR} points to the repo root.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/block-destructive-bash.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/post-edit-check.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/run-tests-on-stop.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
