{
  "_comment": "Cordone 2 — Claude Code hooks. MERGE questo dentro il .claude/settings.json del repo target (PROGETTO, non ~/.claude). NON sovrascrivere settings esistenti: aggiungi solo la chiave 'hooks'. ${CLAUDE_PROJECT_DIR} punta alla root del repo.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/block-destructive-bash.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/post-edit-check.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/enforcement/scripts/run-tests-on-stop.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
